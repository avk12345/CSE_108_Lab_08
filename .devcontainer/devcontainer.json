{
  "name": "CSE 108 development",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--publish=127.0.0.1:5000:5000",
    "--publish=127.0.0.1:5173:5173"
  ],
  "postCreateCommand": "python -m pip install -r requirements.txt && cd frontend && npm ci",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "oxc.oxc-vscode"]
    }
  }
}
